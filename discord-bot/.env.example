# Copy this file to ".env" and fill in the three values below.
# (On a host like Railway/Render, set them as environment variables instead.)

# The bot token from the Discord Developer Portal (Bot tab → Reset Token).
DISCORD_TOKEN=paste-your-bot-token-here

# The ONE channel the bot is allowed to post in.
# In Discord: User Settings → Advanced → turn on Developer Mode, then
# right-click the channel → Copy Channel ID.
CHANNEL_ID=paste-the-channel-id-here

# Your server's ID (right-click the server icon → Copy Server ID).
# Needed so the bot can turn a saved username into a real @mention.
GUILD_ID=paste-your-server-id-here

# --- Optional -------------------------------------------------------------
# The bot already has the public BagelTools Firebase config baked in, so you
# normally leave everything below blank. Only set these if you fork the site
# onto a different Firebase project (copy the values from js/config.js).
# FB_API_KEY=
# FB_AUTH_DOMAIN=
# FB_PROJECT_ID=
# FB_STORAGE=
# FB_SENDER=
# FB_APP_ID=
